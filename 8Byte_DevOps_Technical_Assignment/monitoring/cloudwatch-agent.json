{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "namespace": "8Byte/Application",
    "append_dimensions": { "AutoScalingGroupName": "${aws:AutoScalingGroupName}", "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] },
      "cpu": { "measurement": ["cpu_usage_idle"] }
    }
  },
  "logs": { "logs_collected": { "files": { "collect_list": [
    { "file_path": "/var/log/messages", "log_group_name": "/8byte/CHANGE_ME/system", "log_stream_name": "{instance_id}" },
    { "file_path": "/var/lib/docker/containers/*/*.log", "log_group_name": "/8byte/CHANGE_ME/application", "log_stream_name": "{instance_id}" }
  ] } } }
}

locals { name = "${var.project}-${var.environment}" }
resource "aws_sns_topic" "alerts" { name = "${local.name}-alerts" }
resource "aws_sns_topic_subscription" "email" { topic_arn = aws_sns_topic.alerts.arn protocol = "email" endpoint = var.alert_email }
resource "aws_cloudwatch_dashboard" "infrastructure" { dashboard_name = "${local.name}-infrastructure" dashboard_body = jsonencode({ widgets = [{ type = "metric", properties = { title = "RDS health", region = "${data.aws_region.current.name}", metrics = [["AWS/RDS", "CPUUtilization", "DBInstanceIdentifier", var.db_identifier], [".", "DatabaseConnections", ".", "."], [".", "FreeStorageSpace", ".", "."]], period = 300, stat = "Average" } }, { type = "metric", properties = { title = "EC2 fleet CPU", region = "${data.aws_region.current.name}", metrics = [["AWS/EC2", "CPUUtilization", "AutoScalingGroupName", var.asg_name]], period = 300, stat = "Average" } }] }) }
resource "aws_cloudwatch_dashboard" "application" { dashboard_name = "${local.name}-application" dashboard_body = jsonencode({ widgets = [{ type = "metric", properties = { title = "ALB requests and errors", region = "${data.aws_region.current.name}", metrics = [["AWS/ApplicationELB", "RequestCount", "LoadBalancer", var.alb_arn_suffix, { stat = "Sum" }], [".", "HTTPCode_ELB_5XX_Count", ".", ".", { stat = "Sum" }], [".", "TargetResponseTime", ".", ".", { stat = "p95" }]] } }, { type = "metric", properties = { title = "Target health", region = "${data.aws_region.current.name}", metrics = [["AWS/ApplicationELB", "HealthyHostCount", "TargetGroup", var.target_group_arn_suffix, "LoadBalancer", var.alb_arn_suffix]], stat = "Average" } }] }) }
resource "aws_cloudwatch_metric_alarm" "alb_5xx" { alarm_name = "${local.name}-alb-5xx" namespace = "AWS/ApplicationELB" metric_name = "HTTPCode_ELB_5XX_Count" dimensions = { LoadBalancer = var.alb_arn_suffix } statistic = "Sum" period = 300 evaluation_periods = 1 threshold = 5 comparison_operator = "GreaterThanOrEqualToThreshold" alarm_actions = [aws_sns_topic.alerts.arn] }
resource "aws_cloudwatch_metric_alarm" "rds_storage" { alarm_name = "${local.name}-rds-low-storage" namespace = "AWS/RDS" metric_name = "FreeStorageSpace" dimensions = { DBInstanceIdentifier = var.db_identifier } statistic = "Average" period = 300 evaluation_periods = 1 threshold = 2147483648 comparison_operator = "LessThanThreshold" alarm_actions = [aws_sns_topic.alerts.arn] }
data "aws_region" "current" {}
